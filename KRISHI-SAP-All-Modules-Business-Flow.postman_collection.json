  "item": [
    {
      "name": "00 Login (sets token)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/admin/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let j = {};",
              "try { j = pm.response.json(); } catch (e) {}",
              "const t = j.token || j.data?.token || \"\";",
              "if (t) pm.collectionVariables.set(\"token\", t);"
            ]
          }
        }
      ]
    },
    {
      "name": "A Feeding — Plant → Order → Flock → Materials → Stock → Save → SAP Sync",
      "item": [
        {
          "name": "01 GET Plants",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/sap-live/plants"
          }
        },
        {
          "name": "02 GET Orders (feeding)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/sap-live/orders?module=feeding&werks={{plant_code}}"
          }
        },
        {
          "name": "03 GET Flocks (feeding)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/sap-live/flocks?module=feeding&werks={{plant_code}}&aufnr={{order_no}}"
          }
        },
        {
          "name": "04 GET SAP Materials (feed)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/daily-activity/sap/materials?plant_code={{plant_code}}&type=feed"
          }
        },
        {
          "name": "05 GET Feeding Items (local master)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/daily-activity/feeding/items?plant_code={{plant_code}}&type=feed&module=Breeder"
          }
        },
        {
          "name": "06 GET Feeding Stock (local)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/daily-activity/feeding/stock?plant_code={{plant_code}}&type=feed&module=Breeder"
          }
        },
        {
          "name": "06A GET SAP Material Stock (lgort)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/daily-activity/sap/material-stock?plant_code={{plant_code}}&matnr={{sap_matnr}}"
          }
        },
        {
          "name": "07 GET Flock Detail / Activity menu",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/daily-activity/flock-detail/{{flock_no}}?plant_code={{plant_code}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = {};",
                  "try { j = pm.response.json(); } catch (e) {}",
                  "const a = j.data?.age_days ?? j.data?.flock_info?.age_days;",
                  "if (a != null) pm.collectionVariables.set(\"age_days\", String(a));"
                ]
              }
            }
          ]
        },
        {
          "name": "08 POST Feeding Save (qty <= SAP stock)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/daily-activity/feeding/save",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"flock_no\": \"{{flock_no}}\",\n  \"plant_code\": \"{{plant_code}}\",\n  \"order_no\": \"{{order_no}}\",\n  \"batch_no\": \"{{sap_batch}}\",\n  \"feed_date\": \"{{today_ymd}}\",\n  \"feed_type\": \"feed\",\n  \"zzage\": {{age_days}},\n  \"items\": [\n    {\n      \"sap_matnr\": \"{{sap_matnr}}\",\n      \"lgort\": \"{{sap_lgort}}\",\n      \"qty_issued_male\": 1,\n      \"qty_issued_female\": 1,\n      \"cum_feed\": 2\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = {};",
                  "try { j = pm.response.json(); } catch (e) {}",
                  "const id = j.saved?.[0]?.id;",
                  "if (id) pm.collectionVariables.set(\"feeding_record_id\", String(id));",
                  "const bw = j.bird_weight?.id;",
                  "if (bw) pm.collectionVariables.set(\"bird_weight_record_id\", String(bw));"
                ]
              }
            }
          ]
        },
        {
          "name": "09 POST SAP Sync (marks sap_synced if SAP OK)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/sap-sync",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"module\": \"feeding\",\n  \"record_id\": {{feeding_record_id}}\n}"
            }
          }
        },
        {
          "name": "10 GET SAP Sync Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/sap-sync/status?module=feeding&record_id={{feeding_record_id}}"
          }
        }
      ]
    },
