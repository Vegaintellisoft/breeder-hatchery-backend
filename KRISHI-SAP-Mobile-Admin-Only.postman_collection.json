    {
      "name": "01 Login",
      "item": [
        {
          "name": "POST /api/admin/login (mobile user)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('mobile login 200', function(){ pm.response.to.have.status(200); });",
                  "var j = pm.response.json();",
                  "pm.test('mobile token exists', function(){ pm.expect(!!j.token).to.eql(true); });",
                  "if (j.token) pm.collectionVariables.set('mobile_token', j.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{mobile_username}}\",\n  \"password\": \"{{mobile_password}}\",\n  \"category\": \"Breeder\"\n}"
            },
            "url": "{{baseUrl}}/api/admin/login"
          }
        },
        {
          "name": "POST /api/admin/login (admin user)",
          "event": [
