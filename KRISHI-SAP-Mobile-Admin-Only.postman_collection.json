          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": "{{baseUrl}}/api/sap-sync/status?module=feeding&record_id={{feeding_record_id}}"
          }
        }
