    {
      "name": "02 Mobile - Local Save + SAP Sync Today",
      "item": [
        {
          "name": "POST /api/daily-activity/feeding/save (local save)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const now = new Date();",
                  "const y = now.getFullYear();",
                  "const m = String(now.getMonth()+1).padStart(2,'0');",
                  "const d = String(now.getDate()).padStart(2,'0');",
                  "pm.collectionVariables.set('today_ymd', `${y}-${m}-${d}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('local save status', function(){ pm.expect(pm.response.code).to.be.oneOf([200,201]); });",
                  "var j = pm.response.json();",
                  "pm.test('local save success', function(){ pm.expect(j.success).to.eql(true); });",
                  "if (j.saved && j.saved.length && j.saved[0].id) pm.collectionVariables.set('feeding_record_id', String(j.saved[0].id));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{mobile_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"flock_no\": \"{{flock_no}}\",\n  \"plant_code\": \"{{plant_code}}\",\n  \"feed_date\": \"{{today_ymd}}\",\n  \"order_no\": \"{{order_no}}\",\n  \"batch_no\": \"{{sap_batch}}\",\n  \"feed_type\": \"feed\",\n  \"items\": [\n    {\n      \"sap_matnr\": \"{{sap_matnr}}\",\n      \"lgort\": \"{{sap_lgort}}\",\n      \"qty_issued_male\": {{feed_qty_male}},\n      \"qty_issued_female\": {{feed_qty_female}},\n      \"cum_feed\": 250\n    }\n  ],\n  \"male_weight\": {{male_weight}},\n  \"female_weight\": {{female_weight}}\n}"
            },
            "url": "{{baseUrl}}/api/daily-activity/feeding/save"
          }
        },
        {
          "name": "POST /api/daily-activity/feeding/save (stock exceeded -> 422)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('save blocks when stock is less', function(){ pm.response.to.have.status(422); });",
                  "var j = pm.response.json();",
                  "pm.test('error message contains stock quantity', function(){ pm.expect(String(j.message||'').toLowerCase()).to.include('stock quantity'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{mobile_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"flock_no\": \"{{flock_no}}\",\n  \"plant_code\": \"{{plant_code}}\",\n  \"feed_date\": \"{{today_ymd}}\",\n  \"order_no\": \"{{order_no}}\",\n  \"batch_no\": \"{{sap_batch}}\",\n  \"feed_type\": \"feed\",\n  \"items\": [\n    {\n      \"sap_matnr\": \"{{sap_matnr}}\",\n      \"lgort\": \"{{sap_lgort}}\",\n      \"qty_issued_male\": 999999,\n      \"qty_issued_female\": 999999,\n      \"cum_feed\": 0\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/daily-activity/feeding/save"
          }
        },
        {
          "name": "GET /api/sap-sync/status (feeding)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function(){ pm.response.to.have.status(200); });",
                  "var j = pm.response.json();",
                  "pm.test('status success', function(){ pm.expect(j.success).to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{mobile_token}}" }],
            "url": "{{baseUrl}}/api/sap-sync/status?module=feeding&record_id={{feeding_record_id}}"
          }
        },
        {
          "name": "POST /api/sap-sync/mobile-latest (no record_id)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('mobile latest response', function(){ pm.expect(pm.response.code).to.be.oneOf([200,422,502,403,409]); });",
                  "var j = pm.response.json();",
                  "pm.test('mobile latest has success flag', function(){ pm.expect(j.hasOwnProperty('success')).to.eql(true); });",
                  "if (j.record_id) pm.collectionVariables.set('feeding_record_id', String(j.record_id));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{mobile_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"module\": \"feeding\"\n}" },
            "url": "{{baseUrl}}/api/sap-sync/mobile-latest"
          }
        },
        {
          "name": "POST /api/sap-sync/push (mobile dry push)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('push response received', function(){ pm.expect(pm.response.code).to.be.oneOf([200,422,502,403]); });",
                  "var j = pm.response.json();",
                  "pm.test('push has success flag', function(){ pm.expect(j.hasOwnProperty('success')).to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{mobile_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"module\": \"feeding\",\n  \"record_id\": {{feeding_record_id}}\n}" },
            "url": "{{baseUrl}}/api/sap-sync/push"
          }
        },
        {
          "name": "POST /api/sap-sync (mobile push + mark synced)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('sync response received', function(){ pm.expect(pm.response.code).to.be.oneOf([200,422,502,403]); });",
                  "var j = pm.response.json();",
                  "pm.test('sync has success flag', function(){ pm.expect(j.hasOwnProperty('success')).to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{mobile_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"module\": \"feeding\",\n  \"record_id\": {{feeding_record_id}}\n}" },
            "url": "{{baseUrl}}/api/sap-sync"
          }
        }
      ]
