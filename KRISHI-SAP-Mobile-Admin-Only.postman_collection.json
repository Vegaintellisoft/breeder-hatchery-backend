                  "pm.test('bulk has counters', function(){ pm.expect(j.hasOwnProperty('succeeded_count')).to.eql(true); pm.expect(j.hasOwnProperty('failed_count')).to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
