    {
      "name": "06 Egg Grading - Local Save + SAP Sync",
      "item": [
        {
          "name": "POST /api/egg-collection/v2/save (local)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{mobile_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"flock_no\": \"{{flock_no}}\",\n  \"plant_code\": \"{{plant_code}}\",\n  \"order_no\": \"{{order_no}}\",\n  \"collection_date\": \"{{today_ymd}}\",\n  \"age_days\": 280,\n  \"season\": \"Summer\",\n  \"slots\": [\n    {\n      \"schedule_time\": \"7-8\",\n      \"egg_weight\": 58.5,\n      \"rows\": [\n        {\n          \"shed_id\": 1,\n          \"part_id\": 1,\n          \"line_id\": 1,\n          \"table_egg\": 10,\n          \"jumbo_egg\": 5,\n          \"crack_egg\": 2,\n          \"waste_reject_egg\": 1,\n          \"hatching_egg\": 20\n        }\n      ]\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/egg-collection/v2/save"
          }
        },
        {
