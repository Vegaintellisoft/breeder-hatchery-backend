{
  "info": {
    "_postman_id": "a7c3e901-feed-parent-sap-0001",
    "name": "KRISHI — Daily feed parent_id + SAP batch (minimal)",
    "description": "Import-only mini collection.\n\nCHECKLIST:\n1) Restart API with latest code (422 must include hint about parent_id).\n2) Login first so {{token}} is set.\n3) For parent batch use Body → raw → JSON: {\"parent_id\":\"PLANT_YYYY-MM-DD_FLOCK\"} with Header Content-Type: application/json. Or use request 3b (parent_id in URL query).\n4) If {{parent_id}} is empty, run step 2 or set collection variable parent_id to a real value from the grid (not the literal text {{parent_id}}).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000" },
    { "key": "username", "value": "admin" },
    { "key": "password", "value": "admin123" },
    { "key": "token", "value": "" },
    { "key": "parent_id", "value": "1904_2026-05-08_LY000001" },
    { "key": "feeding_record_id", "value": "169" }
  ],
  "item": [
    {
      "name": "1 — Login (saves token)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/api/admin/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let j = {};",
              "try { j = pm.response.json(); } catch (e) {}",
              "const t = j.token || j.data?.token || j.access_token || '';",
              "if (t) { pm.collectionVariables.set('token', t); }",
              "pm.test('Login 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "2 — GET daily-feed grid (copy parent_id or auto-set from first row)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{base_url}}/api/admin/grid/daily-feed"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let j = {};",
              "try { j = pm.response.json(); } catch (e) {}",
              "const row = j.data && j.data[0];",
              "if (row && row.parent_id) {",
              "  pm.collectionVariables.set('parent_id', row.parent_id);",
              "  console.log('Set parent_id to', row.parent_id);",
              "}",
              "pm.test('Grid 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "3 — POST sap-sync by parent_id (JSON body — needs real parent_id value)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{base_url}}/api/sap-sync",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"parent_id\": \"{{parent_id}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('SAP batch responded', () => pm.expect(pm.response.code).to.be.oneOf([200, 207, 400, 403, 404, 422, 502]));",
              "let j = {}; try { j = pm.response.json(); } catch (e) {}",
              "if (j.batch) console.log('succeeded', j.succeeded_count, 'failed', j.failed_count, 'skipped', j.skipped_count);"
            ]
          }
        }
      ]
    },
    {
      "name": "3b — POST sap-sync parent_id in URL query (body can be {})",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{base_url}}/api/sap-sync?parent_id={{parent_id}}",
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      }
    },
    {
      "name": "4 — POST sap-sync single line (compare with parent batch)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{base_url}}/api/sap-sync",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"module\": \"feeding\",\n  \"record_id\": {{feeding_record_id}}\n}"
        }
      }
    },
    {
      "name": "5 — GET sap-sync status (single record)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{base_url}}/api/sap-sync/status?module=feeding&record_id={{feeding_record_id}}"
      }
    }
  ]
}
