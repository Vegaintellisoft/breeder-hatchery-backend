            "description": "Check `can_sync_to_sap_mobile` (today IST) vs `can_sync_to_sap_admin`."
          }
        },
        {
          "name": "GET status — egg_collection",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/sap-sync/status?module=egg_collection&record_id={{record_id_egg_collection}}"
          }
        },
        {
          "name": "GET status — mortality",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/sap-sync/status?module=mortality&record_id={{record_id_mortality}}"
          }
