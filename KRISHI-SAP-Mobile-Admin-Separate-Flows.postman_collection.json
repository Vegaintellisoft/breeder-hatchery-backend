            }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["let j={};try{j=pm.response.json();}catch(e){}","const id=j.saved?.[0]?.id||'';if(id) pm.collectionVariables.set('feeding_record_id', String(id));"] } }]
        },
        { "name": "C5 SAP Sync Feed", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{base_url}}/api/sap-sync", "body": { "mode": "raw", "raw": "{\n  \"module\":\"feeding\",\n  \"record_id\":{{feeding_record_id}}\n}" } } }
