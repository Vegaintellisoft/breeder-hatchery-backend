{
  "info": {
    "_postman_id": "3b85df36-2b57-4ceb-8aeb-f3fe7380ff73",
    "name": "KRISHI SAP - Mobile + Admin Separate Flows",
    "description": "Separate flows for Mobile SAP Sync button and Admin panel sync (bulk + grid by id), with module-wise step chains.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000" },
    { "key": "username", "value": "superadmin" },
    { "key": "password", "value": "Krishi@123" },
    { "key": "category", "value": "Breeder" },
    { "key": "token", "value": "" },
    { "key": "plant_code", "value": "1904" },
    { "key": "order_no", "value": "190125000135" },
    { "key": "flock_no", "value": "PL000001" },
    { "key": "today_ymd", "value": "2026-05-08" },
    { "key": "sap_batch", "value": "BD-8A" },
    { "key": "sap_matnr", "value": "FG000096" },
    { "key": "sap_lgort", "value": "0012" },
    { "key": "age_days", "value": "584" },
    { "key": "shed_id", "value": "1" },
    { "key": "part_id", "value": "1" },
    { "key": "line_id", "value": "1" },
    { "key": "feeding_record_id", "value": "" },
    { "key": "medicine_record_id", "value": "" },
    { "key": "egg_record_id", "value": "" },
    { "key": "mortality_record_id", "value": "" },
    { "key": "cull_kill_record_id", "value": "" },
    { "key": "cull_sales_record_id", "value": "" },
    { "key": "bird_weight_record_id", "value": "" }
  ],
  "item": [
    {
      "name": "00 Login",
      "item": [
        {
          "name": "POST /api/admin/login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/admin/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"category\": \"{{category}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = {};",
                  "try { j = pm.response.json(); } catch(e) {}",
                  "const t = j.token || j.data?.token || j.access_token || '';",
                  "if (t) pm.collectionVariables.set('token', t);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 Mobile App Flow (Save then SAP Sync button)",
      "item": [
        {
          "name": "A1 Save Feed Local (mobile)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/api/daily-activity/feeding/save",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"flock_no\": \"{{flock_no}}\",\n  \"plant_code\": \"{{plant_code}}\",\n  \"order_no\": \"{{order_no}}\",\n  \"batch_no\": \"{{sap_batch}}\",\n  \"feed_date\": \"{{today_ymd}}\",\n  \"feed_type\": \"feed\",\n  \"zzage\": {{age_days}},\n  \"male_weight\": 4.65,\n  \"female_weight\": 3.85,\n  \"items\": [\n    {\n      \"sap_matnr\": \"{{sap_matnr}}\",\n      \"lgort\": \"{{sap_lgort}}\",\n      \"qty_issued_male\": 1,\n      \"qty_issued_female\": 1,\n      \"cum_feed\": 2\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = {};",
                  "try { j = pm.response.json(); } catch(e) {}",
                  "const id = j.saved?.[0]?.id || '';",
                  "if (id) pm.collectionVariables.set('feeding_record_id', String(id));"
                ]
              }
            }
          ]
        },
        {
          "name": "A2 Mobile SAP Sync Button (latest unsynced today) - feeding",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/api/sap-sync/mobile-latest",
            "body": { "mode": "raw", "raw": "{\n  \"module\": \"feeding\"\n}" }
          }
        },
        {
          "name": "A3 Mobile SAP Sync Button - egg_collection",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/api/sap-sync/mobile-latest",
            "body": { "mode": "raw", "raw": "{\n  \"module\": \"egg_collection\"\n}" }
          }
        }
      ]
    },
    {
      "name": "02 Admin Panel Flow - Bulk and Grid",
      "item": [
        {
          "name": "B1 Get Unsynced (sap_synced=false)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/sap-sync/unsynced?modules=feeding,egg_collection,mortality,cull_kill,cull_sales,bird_weighing&limit=50"
          }
        },
        {
          "name": "B2 Admin Bulk Sync All Pending",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/api/sap-sync/push-unsynced",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plant_code\": \"{{plant_code}}\",\n  \"limit_per_module\": 25,\n  \"modules\": [\"feeding\",\"egg_collection\",\"mortality\",\"cull_kill\",\"cull_sales\",\"bird_weighing\"]\n}"
            }
          }
        },
        {
          "name": "B3 Grid Sync by ID (individual row)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/api/sap-sync",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"module\": \"feeding\",\n  \"record_id\": {{feeding_record_id}}\n}"
            }
          }
        }
      ]
    },
    {
      "name": "03 Feed Module (Step by Step)",
