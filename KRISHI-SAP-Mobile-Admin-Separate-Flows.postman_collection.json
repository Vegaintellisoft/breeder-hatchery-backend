        { "name": "C3 Flocks (feeding)", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{base_url}}/api/sap-live/flocks?module=feeding&werks={{plant_code}}&aufnr={{order_no}}" } },
